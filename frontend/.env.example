# Copie para .env e ajuste.

# URL base da API REST do back-end
VITE_API_URL=http://localhost:3333

# mock  -> usa dados fictícios + LocalStorage (não chama o back-end)
# api   -> usa somente a API real
# auto  -> tenta a API real; se o servidor estiver fora do ar, cai no mock
VITE_API_MODE=mock

# Número do WhatsApp da loja (somente dígitos, com DDI+DDD)
VITE_WHATSAPP_NUMBER=5511999999999
